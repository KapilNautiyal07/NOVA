# Copy to backend/.env and fill in. Every value here stays on the server —
# the Chrome extension never sees API keys.

# ---------------------------------------------------------------- database
# PostgreSQL (recommended). Create the DB, then run: alembic upgrade head
DATABASE_URL=
# Zero-setup local alternative (tables are auto-created on startup):
# DATABASE_URL=sqlite:///./nova.db

# Optional. Enables shared rate limiting across workers; in-process limiter otherwise.
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- AI providers
# Primary: Gemini. Fallback: Groq. Either one alone works; with none, NOVA still
# handles reminders/tasks/memory/files using its deterministic rule parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main Gemini model is overloaded (503) or slow; skipped models retry after 60 s.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Which provider to try first: gemini | groq. Users can override it in Settings.
PREFERRED_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=20
# Retries per provider for timeouts / 5xx before falling back to the next provider.
LLM_MAX_RETRIES=2
# After a 429 the provider is skipped for this long.
PROVIDER_COOLDOWN_SECONDS=60
# Most time NOVA spends understanding one command (all retries/fallbacks) before using its rule parser.
INTENT_DEADLINE_SECONDS=8
CHAT_DEADLINE_SECONDS=25

# ---------------------------------------------------------------- voice
# Speech-to-text providers in order. Gemini's transcription model handles self-corrections
# ("6, no, 7 AM"), names and spoken emails well; Groq Whisper is ~5x faster and is used for
# live captions and whenever Gemini is rate-limited or down. Needs GEMINI_API_KEY and/or GROQ_API_KEY.
STT_PROVIDERS=gemini,groq
GEMINI_STT_MODEL=gemini-3.5-transcribe
# BCP-47 accent/language hints (empty = auto-detect)
STT_LANGUAGE_CODES=en-IN,en-US
# Spoken replies (Gemini TTS). On a 429 the lite model is used; if both fail the extension
# falls back to the browser's built-in voice. Free tier: only a few TTS requests per minute.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
# One of the 30 prebuilt voices (Kore, Puck, Charon, Aoede, …); users can pick in Settings.
TTS_DEFAULT_VOICE=Kore

# ---------------------------------------------------------------- Google Calendar (optional)
# Google Cloud Console → APIs & Services: enable "Google Calendar API", configure the OAuth
# consent screen (add yourself as a test user), then Credentials → Create OAuth client ID →
# "Web application" with this exact Authorized redirect URI. NOVA requests only the
# calendar.events scope. The secret never leaves this server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Meeting length when the user doesn't say one (shown in the confirmation, so it can be changed).
CALENDAR_DEFAULT_MINUTES=30
# Encrypts stored Google tokens. Required in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- security
# Strongly recommended outside localhost: required to create an account from the extension.
REGISTRATION_SECRET=
# Comma-separated CORS origins; * matches an extension ID.
ALLOWED_ORIGINS=chrome-extension://*,http://localhost,http://127.0.0.1
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------- privacy
# Hard cap on page text the server will forward to an AI provider (characters).
MAX_PAGE_CHARS=6000
MAX_AUDIO_BYTES=10485760

LOG_LEVEL=INFO
